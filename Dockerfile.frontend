# syntax=docker/dockerfile:1
ARG BUN_VERSION=1.4.5
FROM oven/bun:${BUN_VERSION}-alpine AS builder
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY server.js ./
COPY lib ./lib
COPY scripts ./scripts
COPY dist ./dist
RUN SOL_EXTERNAL_CALCULATOR=1 bun run build

FROM oven/bun:${BUN_VERSION}-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    SOL_CALC_SOCKET=/run/huongnang/calc.sock \
    PORT=5173 \
    LOG_LEVEL=info
COPY --from=builder --chown=bun:bun /app/build/ ./
USER bun
EXPOSE 5173
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD bun -e 'const r = await fetch("http://127.0.0.1:" + (process.env.PORT || "5173") + "/app.js", { method: "HEAD" }); process.exit(r.ok ? 0 : 1);'
CMD ["bun", "server.js"]
