# Every Bun replica must use the same standalone Redis primary.
REDIS_URL=redis://127.0.0.1:6379
# Production remote Redis: use rediss:// with credentials from your secret manager.
# OPEN_METEO_API_KEY=

# Set true when the public website is HTTPS (including behind a reverse proxy).
COOKIE_SECURE=false

# Application console output is one JSON object per line.
LOG_LEVEL=info
